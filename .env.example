ITEMIT_BASE_URL=https://api.itemit.com/v1

ITEMIT_API_KEY=your_api_key_here
ITEMIT_USER_ID=your_user_id_here
ITEMIT_USER_TOKEN=your_user_token_here
ITEMIT_WORKSPACE_ID=your_workspace_id_here

# Conservative process-local request budget and cache lifetimes (seconds).
# Use one shared limiter if multiple processes use this API key.
ITEMIT_REQUESTS_PER_MINUTE=70
ITEMIT_ITEM_CACHE_TTL_SECONDS=1800
ITEMIT_COLLECTION_CACHE_TTL_SECONDS=1800
ITEMIT_LOCATION_CACHE_TTL_SECONDS=3600

# Firestore mapping persistence. Do not commit this JSON credential file.
FOBE_FIREBASE_PROJECT_ID=your-firebase-project-id
FOBE_FIREBASE_CREDENTIALS=C:\secure\firebase-service-account.json
# Mapping writes are disabled unless explicitly enabled on a trusted local host.
FOBE_ENABLE_MAPPING_WRITES=false
# Recorded until request authentication is implemented; not proof of identity.
FOBE_MAPPING_ACTOR=local-unverified

# Optional build-time fallback during the runtime-config migration. This value
# becomes public browser code; runtime config normally supplies the live URL.
VITE_API_BASE_URL=https://your-public-gateway.example.com/api

# Local FastAPI service. Leave on loopback when Node-RED runs on this computer.
FOBE_API_HOST=127.0.0.1
FOBE_API_PORT=8000
# FOBE_ASSET_DB=C:\path\to\asset_sync.db
# FOBE_IFC_INDEX_DIR=C:\path\to\FOBE-Assets\public\ifc-index

# Local Vite development proxy (not used by GitHub Pages).
FOBE_NODE_RED_TARGET=http://127.0.0.1:1880
ITEMIT_COLLECTION_SYNC_APPLY=false

# Cloudflare tunnel watcher. GITHUB_TOKEN must have fine-grained Contents:
# Read and write permission only for this repository; it is never committed.
GITHUB_TOKEN=replace_with_local_github_token
REPO_OWNER=your-github-owner
REPO_NAME=FOBE-Asset
GITHUB_BRANCH=main
# Relative paths are resolved from this repository. The default is logs/tunnel.log.
TUNNEL_LOG_PATH=logs/tunnel.log
# Optional: verify this Pages origin is allowed by the tunnel gateway's CORS policy.
# GITHUB_PAGES_ORIGIN=https://your-github-owner.github.io
