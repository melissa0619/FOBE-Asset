ITEMIT_BASE_URL=https://api.itemit.com/v1

ITEMIT_API_KEY=your_api_key_here
ITEMIT_USER_ID=your_user_id_here
ITEMIT_USER_TOKEN=your_user_token_here
ITEMIT_WORKSPACE_ID=your_workspace_id_here

# Conservative process-local request budget and cache lifetimes (seconds).
# Use one shared limiter if multiple processes use this API key.
ITEMIT_REQUESTS_PER_MINUTE=70
ITEMIT_ITEM_CACHE_TTL_SECONDS=1800
ITEMIT_COLLECTION_CACHE_TTL_SECONDS=1800
ITEMIT_LOCATION_CACHE_TTL_SECONDS=3600

# Firestore mapping persistence. Do not commit this JSON credential file.
FOBE_FIREBASE_PROJECT_ID=your-firebase-project-id
FOBE_FIREBASE_CREDENTIALS=C:\secure\firebase-service-account.json
# Mapping writes are disabled unless explicitly enabled on a trusted local host.
FOBE_ENABLE_MAPPING_WRITES=false
# Recorded until request authentication is implemented; not proof of identity.
FOBE_MAPPING_ACTOR=local-unverified
